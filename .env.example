# 管理员账号（本地开发默认 admin / admin123）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# 会话签名密钥（随机生成，生产必须修改）
SESSION_SECRET=change_me_to_a_random_string

# 大模型 API（OpenAI-compatible）
LLM_BASE_URL=https://sub2api.megahit.ai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-6-astra

# Semantic Scholar（可选，申请 key 后速率从 100/5min 提升到 5000/5min）
# https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# Google Scholar 代理（可选，scholarly 被限速时使用）
SCHOLAR_PROXY=
